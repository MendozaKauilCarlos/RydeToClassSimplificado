{
  "entities": {
    "User": {
      "title": "User",
      "description": "Estudiantes registrados en la plataforma (pasajeros, conductores o administradores)",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "ID exclusivo de autenticación" },
        "displayName": { "type": "string", "description": "Nombre completo del alumno" },
        "email": { "type": "string", "format": "email", "description": "Correo institucional o personal" },
        "phone": { "type": "string", "description": "Número de teléfono" },
        "photoURL": { "type": "string", "description": "URL de la fotografía de perfil" },
        "role": { "type": "string", "enum": ["passenger", "driver", "admin"], "description": "Rol académico en la plataforma" },
        "suspended": { "type": "boolean", "description": "Si la cuenta está inactiva o suspendida" },
        "tripsCompleted": { "type": "integer", "description": "Número de trayectos escolares realizados" },
        "rating": { "type": "number", "description": "Puntuación de estrella acumulada" },
        "timeSaved": { "type": "string", "description": "Tiempo estimado ahorrado" },
        "vehicle": { "type": "string", "description": "Modelo y color del auto (conductores)" },
        "plates": { "type": "string", "description": "Placas del vehículo (conductores)" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "role"]
    },
    "Trip": {
      "title": "Trip",
      "description": "Viajes/Trayectos solicitados por pasajeros o aceptados por conductores",
      "type": "object",
      "properties": {
        "passengerId": { "type": "string", "description": "ID del pasajero" },
        "driverId": { "type": "string", "description": "ID del conductor asignado" },
        "status": { "type": "string", "enum": ["requested", "pending", "accepted", "picking_up", "in_transit", "completed", "cancelled"], "description": "Estado del viaje" },
        "originName": { "type": "string", "description": "Nombre legible del origen" },
        "destinationName": { "type": "string", "description": "Nombre legible del destino" },
        "origin": { "type": "object", "description": "Coordenadas lat/lng de inicio" },
        "destination": { "type": "object", "description": "Coordenadas lat/lng de fin" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["passengerId", "status"]
    },
    "Route": {
      "title": "Route",
      "description": "Rutas escolares diarias o fijas publicadas por conductores",
      "type": "object",
      "properties": {
        "driverId": { "type": "string", "description": "ID del conductor propietario" },
        "active": { "type": "boolean", "description": "Si la ruta está abierta a pasajeros" },
        "time": { "type": "string", "description": "Horario de salida programado" },
        "originName": { "type": "string" },
        "destinationName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["driverId", "active"]
    },
    "Location": {
      "title": "Location",
      "description": "Ubicación geoespacial en vivo de alumnos en tránsito",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "type": { "type": "string", "enum": ["passenger", "driver"] },
        "position": { "type": "object", "description": "GeoPoint nativo de Firestore con lat/lng" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "position"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Información de perfil académico y de rol de cada estudiante"
    },
    "/trips/{tripId}": {
      "schema": "Trip",
      "description": "Control de trayectos activos, históricos y solicitudes en proceso"
    },
    "/routes/{routeId}": {
      "schema": "Route",
      "description": "Rutas y horarios publicados por alumnos conductores"
    },
    "/locations/{userId}": {
      "schema": "Location",
      "description": "Ubicación en tiempo real para el visor geográfico del mapa"
    }
  }
}
